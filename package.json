{
  "name": "studydocs-pipeline",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/interfaces/http/server.ts",
    "worker": "tsx watch src/worker/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "perf:mongo": "tsx scripts/analyzeMongoPerformance.ts",
    "perf:load": "tsx scripts/loadTest.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.658.0",
    "@aws-sdk/client-sqs": "^3.658.0",
    "@elastic/elasticsearch": "^8.19.2",
    "@fastify/multipart": "^9.0.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.3",
    "@fastify/swagger": "^9.2.0",
    "bcryptjs": "^3.0.3",
    "fastify": "^5.0.0",
    "google-auth-library": "^11.0.2",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^6.9.0",
    "pdf-parse": "^2.4.5",
    "pino": "^9.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.5.0",
    "eslint": "^9.9.0",
    "prettier": "^3.3.3",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.3.0",
    "vitest": "^4.0.0"
  }
}
