MONGO_URI=mongodb://localhost:27017/studydocs
PORT=3000

AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
S3_BUCKET=studydocs-pdfs
SQS_QUEUE_URL=http://sqs.us-east-1.localhost.localstack.cloud:4566/000000000000/studydocs-processing

ELASTICSEARCH_NODE=http://localhost:9200
ELASTICSEARCH_INDEX=documents

# Dev-only secret — generate a real random value before this ever runs
# anywhere but localhost.
JWT_SECRET=dev-only-change-me
JWT_EXPIRES_IN=7d

# Optional: "Sign in with Google". Leave unset and POST /auth/google simply
# doesn't exist — everything else works the same. Create an OAuth 2.0
# "Web application" Client ID in Google Cloud Console, add
# http://localhost:3000 as an authorized JavaScript origin, and put the
# Client ID here (no client secret needed for this flow). The frontend
# needs the same value as VITE_GOOGLE_CLIENT_ID in frontend/.env.
GOOGLE_CLIENT_ID=
